{
  "name": "khaled-cut-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first local video editing studio with FFmpeg.wasm export.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler-dry"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "jose": "6.0.10",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "wavesurfer.js": "^8.1.0"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.4.1",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "3.1.1"
  }
}
