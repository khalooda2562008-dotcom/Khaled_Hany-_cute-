# Local build options. Nothing here is secret: this file is bundled into the
# frontend, so never put API tokens, R2 keys or Access secrets in it.

# Force the R2 panel on even before /api/config confirms it (not needed in
# production: the app detects the deployed Worker automatically).
VITE_CLOUD_STORAGE_ENABLED=false

# Base path for the API. Keep /api for the Worker deployment.
VITE_CLOUD_API_BASE=/api

# Only for a static demo served from a sub-path (e.g. GitHub Pages).
# VITE_BASE_PATH=/

# Worker-side configuration is NOT set here. It lives in Cloudflare:
#   npx wrangler secret put CF_ACCESS_TEAM_DOMAIN
#   npx wrangler secret put CF_ACCESS_AUD
#   npx wrangler secret put TURNSTILE_SECRET      (optional)
#   TURNSTILE_SITE_KEY, STORAGE_QUOTA_BYTES, MAX_UPLOAD_BYTES, MAX_PART_BYTES
#   are plain vars in wrangler.toml.
